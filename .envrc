# Centralized environment variables for container builds
# Used by: direnv (local dev), CI workflows, docker-bake.hcl
#
# Only use it for global variables, useful for all images
#
# After editing, run: direnv allow

# Debian snapshot version for reproducible builds
# See: https://snapshot.debian.org/
export DEBIAN_SNAPSHOT_VERSION="20260503T083940Z"
