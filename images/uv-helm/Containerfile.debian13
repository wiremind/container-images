# syntax=docker.io/docker/dockerfile-upstream:1.20.0

FROM --platform=${BUILDPLATFORM} docker.io/library/debian:trixie-slim

USER root
SHELL ["/bin/bash", "-exo", "pipefail", "-c"]

ARG UV_VERSION=0.11.6
ARG HELM_VERSION=3.17.2
ARG YQ_VERSION=4.44.6
ARG TARGETARCH

# Default UID/GID for uvhelmuser
ARG UID=1001
ARG GID=1001

# hadolint ignore=DL3008
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
<<-EOF
	apt-get update -q
	apt-get install -yq --no-install-recommends passwd coreutils curl ca-certificates git openssh-client curl

	mkdir -p /usr/local/bin

	# Install yq (raw binary; derive SHA-256 column from checksums_hashes_order)
	curl -sLO "https://github.com/mikefarah/yq/releases/download/v${YQ_VERSION}/yq_linux_${TARGETARCH}"
	curl -sLO "https://github.com/mikefarah/yq/releases/download/v${YQ_VERSION}/checksums"
	curl -sLO "https://github.com/mikefarah/yq/releases/download/v${YQ_VERSION}/checksums_hashes_order"
	SHA256_COL=$(awk '/^SHA-256$/{print NR+1; exit}' checksums_hashes_order)
	EXPECTED_YQ_SHA256=$(grep "^yq_linux_${TARGETARCH} " checksums | awk -v col="${SHA256_COL}" '{print $col}')
	echo "${EXPECTED_YQ_SHA256}  yq_linux_${TARGETARCH}" | sha256sum --strict --check -
	chmod +x "yq_linux_${TARGETARCH}"
	mv "yq_linux_${TARGETARCH}" /usr/local/bin/yq
	rm checksums checksums_hashes_order

	# uv uses different arch names than Docker (amd64→x86_64, arm64→aarch64)
	case "${TARGETARCH}" in
	  amd64) UV_ARCH="x86_64" ;;
	  arm64) UV_ARCH="aarch64" ;;
	  *) UV_ARCH="x86_64" ;;
	esac

	# Install uv
	curl -sLO "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-${UV_ARCH}-unknown-linux-gnu.tar.gz"
	curl -sLO "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-${UV_ARCH}-unknown-linux-gnu.tar.gz.sha256"
	sha256sum --strict --check "uv-${UV_ARCH}-unknown-linux-gnu.tar.gz.sha256"
	tar -xzf "uv-${UV_ARCH}-unknown-linux-gnu.tar.gz" --strip-components=1 -C /usr/local/bin \
	  "uv-${UV_ARCH}-unknown-linux-gnu/uv" \
	  "uv-${UV_ARCH}-unknown-linux-gnu/uvx"
	rm "uv-${UV_ARCH}-unknown-linux-gnu.tar.gz" "uv-${UV_ARCH}-unknown-linux-gnu.tar.gz.sha256"

	# Install helm (sha256 file contains bare hash only; append filename to make it checkable)
	curl -sLO "https://get.helm.sh/helm-v${HELM_VERSION}-linux-${TARGETARCH}.tar.gz"
	curl -sLO "https://get.helm.sh/helm-v${HELM_VERSION}-linux-${TARGETARCH}.tar.gz.sha256"
	sed -i "s|\$|  helm-v${HELM_VERSION}-linux-${TARGETARCH}.tar.gz|" "helm-v${HELM_VERSION}-linux-${TARGETARCH}.tar.gz.sha256"
	sha256sum --strict --check "helm-v${HELM_VERSION}-linux-${TARGETARCH}.tar.gz.sha256"
	tar -xzf "helm-v${HELM_VERSION}-linux-${TARGETARCH}.tar.gz" --strip-components=1 -C /usr/local/bin \
	  "linux-${TARGETARCH}/helm"
	rm "helm-v${HELM_VERSION}-linux-${TARGETARCH}.tar.gz" "helm-v${HELM_VERSION}-linux-${TARGETARCH}.tar.gz.sha256"

	groupadd --gid ${GID} uvhelmuser
	useradd --uid ${UID} --gid ${GID} --home-dir /home/uvhelmuser --create-home --shell /sbin/nologin uvhelmuser
EOF

ENV PATH="/home/uvhelmuser/.local/bin:${PATH}"

USER uvhelmuser
WORKDIR /home/uvhelmuser
